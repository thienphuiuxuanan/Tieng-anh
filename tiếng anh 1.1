<!DOCTYPE html>
<html lang="vi" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quiz Master - Chinh Phục Ngữ Pháp Anh</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: '#6366f1',
                        secondary: '#ec4899',
                    }
                }
            }
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.5.1/dist/confetti.browser.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Quicksand', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 min-h-screen flex flex-col transition-colors duration-300">

    <!-- Header / Theme Toggle -->
    <header class="p-4 flex justify-between items-center max-w-4xl mx-auto w-full">
        <h1 class="text-xl font-bold bg-gradient-to-r from-indigo-500 to-pink-500 bg-clip-text text-transparent">Cà Mini Quiz 🚀</h1>
        <button onclick="toggleTheme()" class="p-2 rounded-full bg-slate-200 dark:bg-slate-800 hover:scale-105 transition">
            <svg id="sun-icon" class="w-6 h-6 hidden dark:block text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            <svg id="moon-icon" class="w-6 h-6 block dark:hidden text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
        </button>
    </header>

    <!-- Main Container -->
    <main class="flex-1 flex items-center justify-center p-4">
        
        <!-- Screen 1: Welcome & Name Input -->
        <div id="screen-welcome" class="w-full max-w-md bg-white dark:bg-slate-800 p-8 rounded-2xl shadow-xl border border-slate-100 dark:border-slate-700 text-center space-y-6">
            <div class="space-y-2">
                <span class="text-4xl">📚</span>
                <h2 class="text-2xl font-bold">Thử Thách Ngữ Pháp</h2>
                <p class="text-sm text-slate-500 dark:text-slate-400">Chủ động - Bị động & Tương lai đơn - Tương lai gần (50 câu)</p>
            </div>
            <div class="space-y-4 text-left">
                <div>
                    <label class="block text-sm font-semibold mb-1">Nhập tên của bạn:</label>
                    <input type="text" id="username" placeholder="Ví dụ: Cà Rốt..." class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-1">Chọn chế độ:</label>
                    <select id="mode" class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        <option value="easy">🌟 Dễ (Cơ bản, rõ ràng)</option>
                        <option value="hard">🔥 Khó (Nhiều bẫy lừa, đánh lừa tư duy)</option>
                    </select>
                </div>
            </div>
            <button onclick="startPreparation()" class="w-full py-3 bg-gradient-to-r from-indigo-600 to-pink-600 text-white font-bold rounded-xl shadow-lg hover:opacity-95 transition transform active:scale-95">Bắt đầu ngay</button>
        </div>

        <!-- Screen 2: Countdown Effect -->
        <div id="screen-countdown" class="hidden text-center space-y-4">
            <p class="text-xl font-medium text-slate-500">Chuẩn bị tinh thần nhé...</p>
            <div id="countdown-number" class="text-8xl font-black text-indigo-600 animate-bounce">3</div>
        </div>

        <!-- Screen 3: Quiz Screen -->
        <div id="screen-quiz" class="hidden w-full max-w-2xl bg-white dark:bg-slate-800 p-6 md:p-8 rounded-2xl shadow-xl border border-slate-100 dark:border-slate-700 space-y-6">
            <div class="flex justify-between items-center text-sm font-semibold text-slate-500 dark:text-slate-400">
                <span id="question-progress">Câu hỏi 1/50</span>
                <span id="score-badge" class="px-3 py-1 bg-indigo-100 dark:bg-indigo-900/50 text-indigo-600 dark:text-indigo-400 rounded-full">Điểm: 0</span>
            </div>
            
            <!-- Progress Bar -->
            <div class="w-full bg-slate-200 dark:bg-slate-700 h-2 rounded-full overflow-hidden">
                <div id="progress-bar" class="bg-indigo-600 h-full w-0 transition-all duration-300"></div>
            </div>

            <div class="space-y-4">
                <h3 id="question-title" class="text-lg md:text-xl font-bold leading-relaxed"></h3>
                <div id="options-container" class="space-y-3"></div>
            </div>

            <div id="explanation-box" class="hidden p-4 rounded-xl text-sm bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-700"></div>

            <button id="next-btn" onclick="nextQuestion()" class="hidden w-full py-3 bg-indigo-600 text-white font-bold rounded-xl hover:bg-indigo-700 transition">Câu tiếp theo →</button>
        </div>

        <!-- Screen 4: Result Screen -->
        <div id="screen-result" class="hidden w-full max-w-md bg-white dark:bg-slate-800 p-8 rounded-2xl shadow-xl border border-slate-100 dark:border-slate-700 text-center space-y-6">
            <span class="text-6xl">🏆</span>
            <div class="space-y-2">
                <h2 class="text-2xl font-bold">Hoàn thành xuất sắc!</h2>
                <p id="result-name" class="font-semibold text-indigo-600 dark:text-indigo-400"></p>
                <div id="final-score" class="text-4xl font-black my-4"></div>
                <p id="result-comment" class="text-sm text-slate-500 dark:text-slate-400"></p>
            </div>
            <button onclick="location.reload()" class="w-full py-3 bg-gradient-to-r from-indigo-600 to-pink-600 text-white font-bold rounded-xl shadow-lg hover:opacity-95 transition">Làm lại bài quiz</button>
        </div>

    </main>

    <script>
        // Theme Toggle
        function toggleTheme() {
            document.documentElement.classList.toggle('dark');
        }

        // 50 Questions Dataset (Active/Passive + Future Simple/Near Future with Easy & Hard traps)
        const questionsData = [
            // --- EASY QUESTIONS (1-25) ---
            { q: "They will build a new bridge across the river next year.", a: "A new bridge will be built across the river next year.", opts: ["A new bridge will build across the river next year.", "A new bridge will be built across the river next year.", "A new bridge is going to be built across the river next year.", "A new bridge will been built across the river next year."], level: "easy", exp: "Cấu trúc tương lai đơn bị động: Will + be + V3/ed." },
            { q: "She is going to organize a surprise party for him.", a: "A surprise party is going to be organized for him by her.", opts: ["A surprise party is going to organize for him by her.", "A surprise party is going to be organize for him by her.", "A surprise party is going to be organized for him by her.", "A surprise party will be organized for him by her."], level: "easy", exp: "Tương lai gần bị động: Is/am/are going to + be + V3/ed." },
            { q: "Will they finish the project tomorrow?", a: "Will the project be finished tomorrow?", opts: ["Will the project finish tomorrow?", "Will be the project finished tomorrow?", "Will the project be finished tomorrow?", "Is the project going to finished tomorrow?"], level: "easy", exp: "Câu hỏi tương lai đơn bị động đảo 'Will' lên đầu: Will + S + be + V3/ed?" },
            { q: "He will not invite me to the wedding.", a: "I will not be invited to the wedding by him.", opts: ["I will not invite to the wedding by him.", "I will not be invited to the wedding by him.", "I am not going to be invited to the wedding by him.", "I will not been invited to the wedding by him."], level: "easy", exp: "Thể phủ định tương lai đơn bị động: S + will not + be + V3/ed." },
            { q: "Are you going to wash the car this weekend?", a: "Is the car going to be washed by you this weekend?", opts: ["Are the car going to be washed by you this weekend?", "Is the car going to be washed by you this weekend?", "Will the car be washed by you this weekend?", "Is going to the car be washed by you this weekend?"], level: "easy", exp: "Câu hỏi tương lai gần bị động: Is/am/are + S + going to + be + V3/ed?" },
            { q: "They will release a new smartphone version next month.", a: "A new smartphone version will be released next month.", opts: ["A new smartphone version will release next month.", "A new smartphone version will be released next month.", "A new smartphone version is going to release next month.", "A new smartphone version will been released next month."], level: "easy", exp: "Chuyển tân ngữ 'A new smartphone version' làm chủ ngữ, theo sau là 'will be released'." },
            { q: "I am going to buy a new laptop tomorrow.", a: "A new laptop is going to be bought by me tomorrow.", opts: ["A new laptop is going to buy by me tomorrow.", "A new laptop am going to be bought by me tomorrow.", "A new laptop is going to be bought by me tomorrow.", "A new laptop will be bought by me tomorrow."], level: "easy", exp: "Chủ ngữ mới 'A new laptop' số ít nên dùng 'is going to be bought'." },
            { q: "Will the teacher test our knowledge next week?", a: "Will our knowledge be tested by the teacher next week?", opts: ["Will our knowledge test by the teacher next week?", "Will be our knowledge tested by the teacher next week?", "Will our knowledge be tested by the teacher next week?", "Is our knowledge going to tested next week?"], level: "easy", exp: "Dạng câu hỏi tương lai đơn bị động." },
            { q: "The company will launch a new product soon.", a: "A new product will be launched by the company soon.", opts: ["A new product will launch by the company soon.", "A new product will be launched by the company soon.", "A new product is going to launch soon.", "A new product will been launched soon."], level: "easy", exp: "Tương lai đơn bị động: will be launched." },
            { q: "She is going to write a novel next year.", a: "A novel is going to be written by her next year.", opts: ["A novel is going to write by her next year.", "A novel is going to be writed by her next year.", "A novel is going to be written by her next year.", "A novel will be written by her next year."], level: "easy", exp: "Phân từ II của 'write' là 'written'." },
            { q: "They will clean the room before the party.", a: "The room will be cleaned before the party.", opts: ["The room will clean before the party.", "The room will be clean before the party.", "The room will be cleaned before the party.", "The room is going to clean before the party."], level: "easy", exp: "Tương lai đơn bị động: will be cleaned." },
            { q: "We are going to plant many trees in the garden.", a: "Many trees are going to be planted in the garden.", opts: ["Many trees is going to be planted in the garden.", "Many trees are going to plant in the garden.", "Many trees are going to be planted in the garden.", "Many trees will plant in the garden."], level: "easy", exp: "Chủ ngữ 'Many trees' số nhiều nên dùng 'are going to be planted'." },
            { q: "Will they repair your computer tomorrow?", a: "Will your computer be repaired tomorrow?", opts: ["Will your computer repair tomorrow?", "Will your computer be repaired tomorrow?", "Is your computer going to repaired tomorrow?", "Will be your computer repaired tomorrow?"], level: "easy", exp: "Câu hỏi bị động tương lai đơn." },
            { q: "He will give a presentation at the meeting.", a: "A presentation will be given at the meeting by him.", opts: ["A presentation will give at the meeting by him.", "A presentation will be give at the meeting by him.", "A presentation will be given at the meeting by him.", "A presentation is going to give at the meeting."], level: "easy", exp: "V3 của 'give' là 'given'." },
            { q: "They are going to build a supermarket here.", a: "A supermarket is going to be built here.", opts: ["A supermarket is going to build here.", "A supermarket is going to be build here.", "A supermarket is going to be built here.", "A supermarket will build here."], level: "easy", exp: "V3 của 'build' là 'built'." },
            { q: "Will she bake a cake for my birthday?", a: "Will a cake be baked for my birthday by her?", opts: ["Will a cake bake for my birthday by her?", "Will a cake be baked for my birthday by her?", "Is a cake going to baked for my birthday?", "Will be a cake baked for my birthday?"], level: "easy", exp: "Câu hỏi bị động tương lai đơn với 'Will'." },
            { q: "The manager will sign the contract next Monday.", a: "The contract will be signed by the manager next Monday.", opts: ["The contract will sign by the manager next Monday.", "The contract will be sign by the manager next Monday.", "The contract will be signed by the manager next Monday.", "The contract is going to sign next Monday."], level: "easy", exp: "Tương lai đơn bị động chuẩn." },
            { q: "I am going to finish this report by 5 PM.", a: "This report is going to be finished by 5 PM.", opts: ["This report is going to finish by 5 PM.", "This report am going to be finished by 5 PM.", "This report is going to be finished by 5 PM.", "This report will finish by 5 PM."], level: "easy", exp: "Chủ ngữ 'This report' số ít đi với 'is going to be finished'." },
            { q: "Will they deliver the goods next week?", a: "Will the goods be delivered next week?", opts: ["Will the goods deliver next week?", "Will the goods be delivered next week?", "Are the goods going to deliver next week?", "Will be the goods delivered next week?"], level: "easy", exp: "Động từ 'deliver' chuyển sang V3 thành 'delivered'." },
            { q: "She will answer all your questions later.", a: "All your questions will be answered by her later.", opts: ["All your questions will answer by her later.", "All your questions will be answer by her later.", "All your questions will be answered by her later.", "All your questions are going to answer later."], level: "easy", exp: "Tương lai đơn bị động chuẩn." },
            { q: "They are going to paint the house blue.", a: "The house is going to be painted blue.", opts: ["The house is going to paint blue.", "The house is going to be paint blue.", "The house is going to be painted blue.", "The house will paint blue."], level: "easy", exp: "Tương lai gần bị động chuẩn." },
            { q: "Will they catch the thief?", a: "Will the thief be caught?", opts: ["Will the thief catch?", "Will the thief be caught?", "Is the thief going to caught?", "Will be the thief caught?"], level: "easy", exp: "V3 của 'catch' là 'caught'." },
            { q: "He will fix my bicycle tomorrow.", a: "My bicycle will be fixed by him tomorrow.", opts: ["My bicycle will fix by him tomorrow.", "My bicycle will be fix by him tomorrow.", "My bicycle will be fixed by him tomorrow.", "My bicycle is going to fix tomorrow."], level: "easy", exp: "Tương lai đơn bị động chuẩn." },
            { q: "We are going to take many photos on the trip.", a: "Many photos are going to be taken on the trip.", opts: ["Many photos is going to be taken on the trip.", "Many photos are going to take on the trip.", "Many photos are going to be taken on the trip.", "Many photos will take on the trip."], level: "easy", exp: "V3 của 'take' là 'taken'." },
            { q: "Will she choose you for the team?", a: "Will you be chosen for the team by her?", opts: ["Will you choose for the team by her?", "Will you be choose for the team by her?", "Will you be chosen for the team by her?", "Are you going to choose for the team?"], level: "easy", exp: "V3 của 'choose' là 'chosen'." },

            // --- HARD QUESTIONS WITH TRAPS (26-50) ---
            { q: "Tricky Trap: The weather is terrible; it looks like it ___ rain.", a: "is going to", opts: ["will", "is going to", "shall", "is being to"], level: "hard", exp: "Bẫy phân biệt Tương lai đơn và Tương lai gần: Khi có dấu hiệu/bằng chứng cụ thể ngay trước mắt (thời tiết tệ, mây đen...), ta bắt buộc dùng 'is going to'." },
            { q: "Tricky Trap: Accidents ___ happen if drivers are careless.", a: "will", opts: ["are going to", "will", "is going to", "shall"], level: "hard", exp: "Dự đoán chung chung không có căn cứ ngay trước mắt hoặc mang tính quy luật/điều kiện thì dùng 'will'." },
            { q: "Tricky Trap: Look at those black clouds! It ___ rain.", a: "is going to", opts: ["will", "is going to", "shall", "would"], level: "hard", exp: "Dấu hiệu rõ ràng 'nhìn những đám mây đen kìa' -> dùng tương lai gần 'is going to'." },
            { q: "Tricky Trap (Intransitive Verb): An accident ___ on Main Street tomorrow.", a: "Không thể chuyển sang bị động", opts: ["will be happened", "is going to be happened", "will happen", "will be happen"], level: "hard", exp: "Bẫy kinh điển: Động từ nội intransitive như 'happen, occur, arrive, take place' KHÔNG BAO GIỜ có thể bị động! Đáp án đúng là dạng chủ động 'will happen'." },
            { q: "Tricky Trap (Modal Passive): They will have to finish the report by tomorrow.", a: "The report will have to be finished by tomorrow.", opts: ["The report will have to finish by tomorrow.", "The report will have to be finished by tomorrow.", "The report is going to have to finish by tomorrow.", "The report will be have to finished by tomorrow."], level: "hard", exp: "Bẫy kết hợp Modal Verb 'have to' trong tương lai đơn bị động: will have to + be + V3/ed." },
            { q: "Tricky Trap (Causative/Phrasal): Someone is going to break into our house.", a: "Our house is going to be broken into.", opts: ["Our house is going to break into.", "Our house is going to be broken.", "Our house is going to be broken into.", "Our house will be break into."], level: "hard", exp: "Cụm động từ 'break into' khi chuyển sang bị động phải giữ nguyên giới từ 'into' ở cuối." },
            { q: "Tricky Trap: I think robots ___ do all household chores in 2050.", a: "will", opts: ["are going to", "will", "shall", "is going to"], level: "hard", exp: "Dự đoán dựa trên quan điểm cá nhân bắt đầu bằng 'I think' thường dùng tương lai đơn 'will'." },
            { q: "Tricky Trap (Negative Question): Won't they fix the bridge next month?", a: "Won't the bridge be fixed next month?", opts: ["Won't the bridge fix next month?", "Won't the bridge be fixed next month?", "Will the bridge not fix next month?", "Isn't the bridge going to fixed next month?"], level: "hard", exp: "Câu hỏi phủ định bị động tương lai đơn: Won't + S + be + V3/ed?" },
            { q: "Tricky Trap: The plane ___ arrive at 6 PM tomorrow according to schedule.", a: "will", opts: ["is going to", "will", "is arriving", "shall"], level: "hard", exp: "Lịch trình, thời gian biểu cố định trong tương lai thường dùng 'will' hoặc hiện tại đơn, nhưng trong ngữ cảnh này 'will' là chuẩn tương lai." },
            { q: "Tricky Trap: She ___ probably pass the exam easily.", a: "will", opts: ["is going to", "will", "shall", "is"], level: "hard", exp: "Trạng từ chỉ quan điểm như 'probably, certainly, perhaps' thường đi với tương lai đơn 'will'." },
            { q: "Tricky Trap (Intransitive Verb): The meeting will take place in the main hall.", a: "Không thể chuyển sang bị động", opts: ["The meeting will be taken place", "The meeting is going to be taken place", "The meeting will take place", "The meeting will be took place"], level: "hard", exp: "Động từ 'take place' là nội động từ, không có dạng bị động." },
            { q: "Tricky Trap: I'm feeling very tired. I think I ___ go to bed early.", a: "will", opts: ["am going to", "will", "shall", "am to"], level: "hard", exp: "Quyết định bột phát ngay tại thời điểm nói (quyết định ngay lúc cảm thấy mệt) dùng 'will'." },
            { q: "Tricky Trap: What ___ when you graduate?", a: "are you going to do", opts: ["will you do", "are you going to do", "do you do", "will you doing"], level: "hard", exp: "Hỏi về kế hoạch, dự định đã có sẵn từ trước trong tương lai dùng 'are you going to do'." },
            { q: "Tricky Trap (Preposition in Passive): People will talk about this scandal for years.", a: "This scandal will be talked about for years.", opts: ["This scandal will talk about for years.", "This scandal will be talked for years.", "This scandal will be talked about for years.", "This scandal is going to talk about."], level: "hard", exp: "Cụm động từ 'talk about' giữ nguyên 'about' khi sang bị động." },
            { q: "Tricky Trap: By the look of her face, she ___ burst into tears.", a: "is going to", opts: ["will", "is going to", "shall", "would"], level: "hard", exp: "Dấu hiệu nhìn rõ cảm xúc/biểu hiện ngay lúc nói -> dùng tương lai gần 'is going to'." },
            { q: "Tricky Trap: Nobody will solve this difficult puzzle.", a: "This difficult puzzle will not be solved.", opts: ["This difficult puzzle will be solved.", "This difficult puzzle will not be solved.", "This difficult puzzle is not going to solved.", "Nobody will be solved this puzzle."], level: "hard", exp: "Chủ ngữ 'Nobody' mang nghĩa phủ định nên vế bị động phải có 'not'." },
            { q: "Tricky Trap: They are going to appoint him as the new director.", a: "He is going to be appointed as the new director.", opts: ["He is going to appoint as the new director.", "He is going to be appointing as the new director.", "He is going to be appointed as the new director.", "He will appoint as the new director."], level: "hard", exp: "Tương lai gần bị động chuẩn với chủ ngữ 'He' -> 'is going to be appointed'." },
            { q: "Tricky Trap: Will anyone attend the seminar tomorrow?", a: "Will the seminar be attended tomorrow?", opts: ["Will the seminar attend tomorrow?", "Will the seminar be attended tomorrow?", "Is the seminar going to attended?", "Will be the seminar attended?"], level: "hard", exp: "Đại từ bất định 'anyone' ở chủ động có thể lược bỏ khi sang bị động." },
            { q: "Tricky Trap: The chef is going to prepare a special dish for us.", a: "A special dish is going to be prepared for us.", opts: ["A special dish is going to prepare for us.", "A special dish is going to be prepared for us by us.", "A special dish will prepare for us.", "A special dish is going to been prepared."], level: "hard", exp: "Tương lai gần bị động chuẩn." },
            { q: "Tricky Trap: I promise I ___ tell anyone your secret.", a: "will not", opts: ["am not going to", "will not", "shall not to", "won't to"], level: "hard", exp: "Lời hứa (promise) luôn đi với 'will'." },
            { q: "Tricky Trap: Watch out! That heavy box ___ fall.", a: "is going to", opts: ["will", "is going to", "shall", "would"], level: "hard", exp: "Cảnh báo trước mắt 'Watch out!' kết hợp vật nặng sắp rơi -> dùng tương lai gần 'is going to'." },
            { q: "Tricky Trap: They will have completed the task by next Friday.", a: "The task will have been completed by next Friday.", opts: ["The task will have completed by next Friday.", "The task will have been completed by next Friday.", "The task is going to have completed by next Friday.", "The task will be completed by next Friday."], level: "hard", exp: "Bẫy tương lai hoàn thành bị động: will have + been + V3/ed." },
            { q: "Tricky Trap: Who will look after your children while you are away?", a: "Who will your children be looked after by?", opts: ["Who will your children look after?", "Who will your children be looked after?", "Who will your children be looked after by?", "By who will your children be looked after?"], level: "hard", exp: "Câu hỏi bắt đầu bằng 'Who' chuyển thành 'Who ... be + V3 + by?' và giữ nguyên cụm 'look after'." },
            { q: "Tricky Trap: The sun ___ rise at 5:30 AM tomorrow.", a: "will", opts: ["is going to", "will", "shall", "is"], level: "hard", exp: "Sự thật hiển nhiên/quy luật tự nhiên trong tương lai dùng 'will'." },
            { q: "Tricky Trap: They are going to pull down the old theater.", a: "The old theater is going to be pulled down.", opts: ["The old theater is going to pull down.", "The old theater is going to be pulled down.", "The old theater will pull down.", "The old theater is going to be pull down."], level: "hard", exp: "Cụm động từ 'pull down' giữ nguyên 'down' khi sang bị động." }
        ];

        let currentQuestions = [];
        let currentIndex = 0;
        let score = 0;
        let playerName = "";

        // Start Preparation & Countdown
        function startPreparation() {
            const nameInput = document.getElementById('username').value.trim();
            playerName = nameInput !== "" ? nameInput : "Cà Rốt";
            
            const mode = document.getElementById('mode').value;
            
            // Filter questions based on mode
            if (mode === 'easy') {
                currentQuestions = questionsData.filter(q => q.level === 'easy');
            } else {
                currentQuestions = questionsData.filter(q => q.level === 'hard');
            }
            // Shuffle questions
            currentQuestions.sort(() => Math.random() - 0.5);

            // Switch to countdown screen
            document.getElementById('screen-welcome').classList.add('hidden');
            document.getElementById('screen-countdown').classList.remove('hidden');

            let count = 3;
            const countEl = document.getElementById('countdown-number');
            countEl.innerText = count;

            const timer = setInterval(() => {
                count--;
                if (count > 0) {
                    countEl.innerText = count;
                } else if (count === 0) {
                    countEl.innerText = "Bắt đầu! 🚀";
                } else {
                    clearInterval(timer);
                    document.getElementById('screen-countdown').classList.add('hidden');
                    document.getElementById('screen-quiz').classList.remove('hidden');
                    loadQuestion();
                }
            }, 1000);
        }

        // Load Question
        function loadQuestion() {
            const q = currentQuestions[currentIndex];
            document.getElementById('question-progress').innerText = `Câu hỏi ${currentIndex + 1}/${currentQuestions.length}`;
            document.getElementById('score-badge').innerText = `Điểm: ${score}`;
            
            const progressPercent = ((currentIndex) / currentQuestions.length) * 100;
            document.getElementById('progress-bar').style.width = `${progressPercent}%`;

            document.getElementById('question-title').innerText = q.q;
            
            const optionsContainer = document.getElementById('options-container');
            optionsContainer.innerHTML = '';
            
            // Shuffle options
            let shuffledOpts = [...q.opts].sort(() => Math.random() - 0.5);

            shuffledOpts.forEach(opt => {
                const btn = document.createElement('button');
                btn.className = "w-full text-left p-4 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700/50 transition font-medium";
                btn.innerText = opt;
                btn.onclick = () => selectAnswer(btn, opt, q.a, q.exp);
                optionsContainer.appendChild(btn);
            });

            document.getElementById('explanation-box').classList.add('hidden');
            document.getElementById('next-btn').classList.add('hidden');
        }

        // Select Answer
        function selectAnswer(selectedBtn, selectedOpt, correctOpt, explanation) {
            const buttons = document.getElementById('options-container').getElementsByTagName('button');
            
            // Disable all buttons after choice
            for (let btn of buttons) {
                btn.disabled = true;
                if (btn.innerText === correctOpt) {
                    btn.classList.add('bg-green-100', 'border-green-500', 'text-green-700', 'dark:bg-green-900/40', 'dark:text-green-300');
                }
            }

            if (selectedOpt === correctOpt) {
                score += 10;
                selectedBtn.classList.add('bg-green-100', 'border-green-500', 'text-green-700', 'dark:bg-green-900/40', 'dark:text-green-300');
            } else {
                selectedBtn.classList.add('bg-red-100', 'border-red-500', 'text-red-700', 'dark:bg-red-900/40', 'dark:text-red-300');
            }

            document.getElementById('score-badge').innerText = `Điểm: ${score}`;

            // Show explanation
            const expBox = document.getElementById('explanation-box');
            expBox.innerHTML = `<strong>💡 Giải thích:</strong> ${explanation}`;
            expBox.classList.remove('hidden');

            // Show next button
            document.getElementById('next-btn').classList.remove('hidden');
        }

        // Next Question
        function nextQuestion() {
            currentIndex++;
            if (currentIndex < currentQuestions.length) {
                loadQuestion();
            } else {
                showResult();
            }
        }

        // Show Result
        function showResult() {
            document.getElementById('screen-quiz').classList.add('hidden');
            document.getElementById('screen-result').classList.remove('hidden');

            document.getElementById('result-name').innerText = `Thí sinh: ${playerName}`;
            const maxScore = currentQuestions.length * 10;
            document.getElementById('final-score').innerText = `${score} / ${maxScore} điểm`;

            let comment = "";
            const percentage = score / maxScore;
            if (percentage === 1) {
                comment = "Quá đỉnh cao! Bạn đã master hoàn toàn phần này rùi nhó~~ 🎉";
                triggerConfetti();
            } else if (percentage >= 0.8) {
                comment = "Làm bài rất tốt đó nha! Cố gắng phát huy đii dợ! 🌟";
                triggerConfetti();
            } else if (percentage >= 0.5) {
                comment = "Khá ổn rùi nhưng còn vài chỗ sập bẫy nha. Ôn lại thêm chút nữa đii! 💪";
            } else {
                comment = "Cần cẩn thận hơn với mấy câu bẫy khó nhó. Thử lại lần nữa xem sao nà! 🎈";
            }
            document.getElementById('result-comment').innerText = comment;
        }

        // Confetti Effect
        function triggerConfetti() {
            confetti({
                particleCount: 100,
                spread: 70,
                origin: { y: 0.6 }
            });
        }
    </script>
</body>
</html>
